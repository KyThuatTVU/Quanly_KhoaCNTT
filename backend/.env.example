# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ==============================================================================

# Server Configurations
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Database Configurations (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password_here
DB_NAME=quanly_khoacntt_tvu

# JSON Web Token (JWT) Configurations
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 Credentials (For Admin Authentication)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# CORS Configurations
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Logging Level (error, warn, info, http, debug)
LOG_LEVEL=debug
